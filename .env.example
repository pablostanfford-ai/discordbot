# --- Discord Application (https://discord.com/developers/applications) ---
DISCORD_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=your-client-id
DISCORD_CLIENT_SECRET=your-client-secret

# --- Dashboard ---
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8050
# Публичный базовый URL дашборда (для OAuth redirect). В проде: https://example.com
DASHBOARD_BASE_URL=http://localhost:8050
# Секрет для подписи JWT-сессий (обязательно смените!)
JWT_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=72

# Если DISCORD_TOKEN пуст — запускать только дашборд с демо-данными (1/0)
DEMO_MODE=1

# --- Telegram HelpDesk (бот поддержки + Mini App) ---
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Telegram user_id операторов через запятую (узнать: @userinfobot). Пусто = доступ всем (dev)
TELEGRAM_ADMIN_IDS=
# HMAC-секрет Mini App: BotFather → /mybots → Settings → Web App → Bot Verify token (для прод-проверки initData)
TELEGRAM_WEBAPP_SECRET=
# Порт и публичный HTTPS-URL панели (Telegram требует HTTPS для продакшена)
TG_PORT=8060
TG_BASE_URL=http://localhost:8060
